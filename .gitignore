# Python / uv
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Data cache (datasets are fetched, never committed)
data/*
# vendored, provenance-carrying tables ARE committed (tiny; they are the paper input)
!data/lpt_sample.csv
!data/wdpulsar_candidates.csv
.cache/

# Generated analysis artifacts
# Real-run outputs are COMMITTED evidence (post-2026-07-31 integrity incident): results
# JSONs/CSVs, paper figures, and generated macros all carry real-data provenance and are
# reviewed in PRs like any source change. The offline Snakefile DAG is CI smoke ONLY —
# never commit its synthetic outputs (make guard-real enforces this for packaging).
# arXiv packages are assembled from the generated figures + .bbl (regenerate with `make arxiv`).
papers/*/arxiv-submission/

# Airflow runtime
airflow/logs/
airflow/*.cfg
airflow/*.db
airflow/.env

# LaTeX build aux
papers/*/*.aux
papers/*/*.log
papers/*/*.out
papers/*/*.bbl
papers/*/*.blg
papers/*/*.pdf

# OS / editors
.DS_Store

# Snakemake workflow state
.snakemake/
sbi-logs/
dist/
