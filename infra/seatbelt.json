{
  "Version": "2012-10-17",
  "Id": "source-of-truth:jansky-research/infra/seatbelt.json;copy:aws-ai/iam/cost-seatbelt.json;check:make-seatbelt-check",
  "Statement": [
    {
      "Sid": "RegionLock",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "organizations:*",
        "route53:*",
        "cloudfront:*",
        "support:*",
        "budgets:*",
        "ce:*",
        "account:*",
        "health:*",
        "sso:*",
        "identitystore:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "NoHourlyBilledResourcesWithoutEditingThisPolicy",
      "Effect": "Deny",
      "Action": [
        "kendra:CreateIndex",
        "aoss:CreateCollection",
        "sagemaker:CreateEndpoint",
        "rds:CreateDBCluster",
        "rds:CreateDBInstance"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2InstanceTypeAllowlist",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotEquals": {
          "ec2:InstanceType": [
            "t3.micro",
            "t3.small",
            "t4g.small",
            "c7i.4xlarge",
            "c7a.4xlarge",
            "c7a.8xlarge",
            "m7a.2xlarge",
            "r7a.2xlarge",
            "g4dn.xlarge",
            "g5.xlarge",
            "g5.2xlarge",
            "g6.xlarge",
            "g6.2xlarge",
            "g6e.xlarge"
          ]
        }
      }
    },
    {
      "Sid": "NoNatGatewayNoFleetsNoCommitments",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateNatGateway",
        "ec2:CreateFleet",
        "ec2:RequestSpotFleet",
        "ec2:RequestSpotInstances",
        "ec2:AllocateHosts",
        "ec2:PurchaseHostReservation",
        "ec2:PurchaseReservedInstancesOffering",
        "ec2:PurchaseScheduledInstances",
        "ec2:CreateCapacityReservation",
        "savingsplans:CreateSavingsPlan"
      ],
      "Resource": "*"
    }
  ]
}
